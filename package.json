{
  "name": "vst-cloner",
  "version": "0.1.0",
  "private": true,
  "description": "Capture audio effect plugins as open profiles and rebuild them as free clones",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "profile",
    "capture",
    "agent",
    "clone",
    "bridge",
    "apps/desktop"
  ],
  "scripts": {
    "vch": "node capture/bin/vch.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/desktop/tsconfig.json",
    "test": "node --test \"profile/test/*.test.ts\" \"capture/test/*.test.ts\" \"agent/test/*.test.ts\" \"clone/test/*.test.ts\" \"bridge/test/*.test.ts\"",
    "host:configure": "cmake -S host -B host/build -DCMAKE_BUILD_TYPE=Release",
    "host:build": "cmake --build host/build --config Release --parallel",
    "app": "npm run tauri --workspace @vst-cloner/desktop -- dev",
    "app:build": "npm run tauri --workspace @vst-cloner/desktop -- build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
