{
  "name": "vst-cloner",
  "version": "0.1.0",
  "private": true,
  "description": "Capture audio effect plugins as open profiles and rebuild them as free clones",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "profile",
    "capture"
  ],
  "scripts": {
    "vch": "node capture/bin/vch.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"profile/test/*.test.ts\" \"capture/test/*.test.ts\"",
    "host:configure": "cmake -S host -B host/build -DCMAKE_BUILD_TYPE=Release",
    "host:build": "cmake --build host/build --config Release --parallel"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
